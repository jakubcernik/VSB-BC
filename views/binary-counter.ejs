<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: algo.pageTitle, extraCss: algo.cssFiles }) %>
</head>
<body>
<div id="pageTransitionOverlay"></div>
<div id="container">
    <header>
        <h1 id="pageTitle">Amortized complexity — Binary Counter</h1>
        <%- include('partials/nav-sim', { algo: algo }) %>
    </header>

    <!-- Input mode tabs -->
    <nav id="navigation">
        <button onclick="setMode('manual')" id="manualTab" class="active">Manual</button>
        <button onclick="setMode('random')" id="randomTab">Random</button>
        <button onclick="setMode('best')" id="bestTab">Best Case</button>
        <button onclick="setMode('worst')" id="worstTab">Worst Case</button>
    </nav>

    <!-- Trackers -->
    <div id="trackers">
        <div id="creditCounter">Coins: 0</div>
        <div class="metric-counters-group">
            <div id="stepCounter">Steps: 0</div>
            <div id="instructionCounter">Instructions: 0</div>
            <button id="metricsHelpButton" class="metrics-help-button" type="button" onclick="openMetricsHelp()">What do metrics mean?</button>
        </div>
    </div>

    <div id="metricsHelpModal" class="metrics-help-modal" aria-hidden="true">
        <div class="metrics-help-dialog" role="dialog" aria-modal="true" aria-labelledby="metricsHelpTitle">
            <button id="metricsHelpCloseX" class="metrics-help-close" type="button" onclick="closeMetricsHelp()" aria-label="Close">×</button>
            <h3 id="metricsHelpTitle">Metrics explanation</h3>
            <p id="metricsHelpLine1"></p>
            <p id="metricsHelpLine2"></p>
            <p id="metricsHelpLine3"></p>
            <div class="metrics-help-actions">
                <a id="metricsHelpTheoryLink" class="metrics-help-theory-link" href="<%= algo.route %>/theory#method-accounting" onclick="navigateToPage(event, '<%= algo.route %>/theory#method-accounting')">Open theory</a>
                <button id="metricsHelpCloseBtn" class="btn-secondary" type="button" onclick="closeMetricsHelp()">Close</button>
            </div>
        </div>
    </div>

    <div class="input-group" id="bitLengthControls">
        <label for="bitLengthSelect" id="bitLengthLabel">Bit length:</label>
        <select id="bitLengthSelect" onchange="setBitLengthFromUI()">
            <option value="4">4</option>
            <option value="6">6</option>
            <option value="8"<%= algo.params.defaultBits === 8 ? ' selected' : '' %>>8</option>
            <option value="10">10</option>
            <option value="12">12</option>
        </select>
        <span id="bitLengthHint"></span>
    </div>

    <main id="mainContent">

        <!-- Manual Mode -->
        <section id="manualMode" class="mode active">
            <div class="input-group">
                <button onclick="increment()" id="btnIncrement">+ Increment</button>
                <button onclick="resetCounter()" id="btnReset">↺ Reset</button>
            </div>
        </section>

        <!-- Random Mode -->
        <section id="randomMode" class="mode">
            <h2 id="randomModeTitle">Random Mode</h2>
            <p id="randomModeDesc"></p>
            <div class="input-group">
                <label for="randomMinTrailing" id="randomMinTrailingLabel">Min trailing 1s:</label>
                <input type="number" id="randomMinTrailing" placeholder="0" min="0" max="7" value="0">
                <label for="randomMaxTrailing" id="randomMaxTrailingLabel">Max trailing 1s:</label>
                <input type="number" id="randomMaxTrailing" placeholder="3" min="0" max="7" value="3">
            </div>
            <button onclick="generateRandom()" id="btnGenRandom">Generate</button>
        </section>

        <!-- Best Case Mode -->
        <section id="bestMode" class="mode">
            <h2 id="bestCaseTitle">Best Case</h2>
            <div class="description-box">
                <p id="bestCaseDesc"></p>
                <div class="control-panel case-controls">
                    <div class="case-step-label" id="bestStepPrepareLabel">1) Prepare variant</div>
                    <div class="case-actions-row">
                        <button onclick="prepareBestCase()" id="btnRunBest">Prepare Best Case</button>
                        <button onclick="prepareBestCase(true)" id="btnRunBestAlt">Next Variant</button>
                    </div>
                    <div class="case-step-label" id="bestStepRunLabel">2) Run one increment</div>
                    <button onclick="incrementPreparedCase('best')" id="btnBestIncrement" class="case-primary-action">+ Increment prepared case</button>
                </div>
            </div>
        </section>

        <!-- Worst Case Mode -->
        <section id="worstMode" class="mode">
            <h2 id="worstCaseTitle">Worst Case</h2>
            <div class="description-box">
                <p id="worstCaseDesc"></p>
                <div class="control-panel case-controls">
                    <div class="case-step-label" id="worstStepPrepareLabel">1) Prepare variant</div>
                    <div class="case-actions-row">
                        <button onclick="prepareWorstCase()" id="btnRunWorst">Prepare Worst Case</button>
                        <button onclick="prepareWorstCase(true)" id="btnRunWorstAlt">Next Variant</button>
                    </div>
                    <div class="case-step-label" id="worstStepRunLabel">2) Run one increment</div>
                    <button onclick="incrementPreparedCase('worst')" id="btnWorstIncrement" class="case-primary-action">+ Increment prepared case</button>
                </div>
            </div>
        </section>

        <!-- Binary counter visualization -->
        <div id="counterVisualization">
            <div id="operationBank">
                <div id="bankLabel">Poplatek za operaci</div>
                <div id="bankCoins"></div>
            </div>
            <div id="bitsRow"></div>
            <div id="decimalDisplay">Value: 0</div>
        </div>
    </main>

    <!-- Log panel -->
    <div id="infoPanel">Steps will appear here</div>
</div>

<% algo.jsFiles.forEach(function(f) { %>
<script src="/<%= f %>"></script>
<% }); %>

<%- include('partials/footer') %>
</body>
</html>
