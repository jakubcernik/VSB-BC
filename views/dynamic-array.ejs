<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: algo.pageTitle, extraCss: algo.cssFiles }) %>
</head>
<body>
<div id="pageTransitionOverlay"></div>
<div id="container">
    <header>
        <h1>Amortized complexity for vector&lt;&gt;</h1>
        <nav id="pageNav">
            <a href="/" id="pageNavHome" onclick="navigateToPage(event, '/')">🏠 <span id="pageNavHomeLabel">Home</span></a>
            <span class="page-nav-divider">|</span>
            <span id="pageNavSimActive">⚙️ <span id="pageNavSimLabel">Simulation</span></span>
            <span class="page-nav-divider">|</span>
            <a href="<%= algo.route %>/theory" id="pageNavTheory" onclick="navigateToPage(event, '<%= algo.route %>/theory')">📖 <span id="pageNavTheoryLabel">Theory</span></a>
        </nav>
    </header>

    <!-- Input mode -->
    <nav id="navigation">
        <button onclick="setMode('manual')" id="manualTab" class="active">Manual</button>
        <button onclick="setMode('random')" id="randomTab">Random</button>
        <button onclick="setMode('best')" id="bestTab">Best Case</button>
        <button onclick="setMode('worst')" id="worstTab">Worst Case</button>
    </nav>

    <!-- Trackers -->
    <div id="trackers">
        <div id="creditCounter">Saved coins (bank): 0</div>
        <div class="metric-counters-group" id="metricCountersGroup">
            <div id="stepCounter">Steps: 0</div>
            <div id="instructionCounter">Instructions: 0</div>
            <button id="metricsHelpButton" class="metrics-help-button" type="button" onclick="openMetricsHelp()">Co znamenají metriky?</button>
        </div>
    </div>

    <div id="metricsHelpModal" class="metrics-help-modal" aria-hidden="true">
        <div class="metrics-help-dialog" role="dialog" aria-modal="true" aria-labelledby="metricsHelpTitle">
            <button id="metricsHelpCloseX" class="metrics-help-close" type="button" onclick="closeMetricsHelp()" aria-label="Close">×</button>
            <h3 id="metricsHelpTitle">Vysvětlení metrik</h3>
            <p id="metricsHelpLine1"></p>
            <p id="metricsHelpLine2"></p>
            <p id="metricsHelpLine3"></p>
            <div class="metrics-help-actions">
                <a id="metricsHelpTheoryLink" class="metrics-help-theory-link" href="<%= algo.route %>/theory#method-accounting" onclick="navigateToPage(event, '<%= algo.route %>/theory#method-accounting')">Otevřít teorii</a>
                <button id="metricsHelpCloseBtn" class="btn-secondary" type="button" onclick="closeMetricsHelp()">Zavřít</button>
            </div>
        </div>
    </div>

    <main id="mainContent">
        <!-- Manual Mode -->
        <section id="manualMode" class="mode active modern-controls">
            <div class="control-card">
                <h3 class="control-title" id="manualStepTitle">Step Controls</h3>
                <div class="input-group manual-step-controls control-row">
                    <label id="manualInputLabel" for="manualInput" class="visually-hidden">Enter a number</label>
                    <input type="number" id="manualInput" placeholder="Enter a number">
                    <button class="btn-secondary" id="btnSmallStep" onclick="runSmallStepFromInput()">Small Step</button>
                    <button class="btn-primary" id="btnBigStep" onclick="runBigStepFromInput()">Big Step</button>
                </div>
                <details class="step-help" id="stepHelp">
                    <summary id="stepHelpSummary">What is small vs big step?</summary>
                    <div class="step-help-text" id="stepHelpText"></div>
                </details>
            </div>
        </section>

        <!-- Random Mode -->
        <section id="randomMode" class="mode modern-controls">
            <div class="control-card">
                <h3 class="control-title" id="randomParamsTitle">Generation Parameters</h3>
                <div class="input-group random-params control-row">
                    <label for="randomCount">Count:</label>
                    <input type="number" id="randomCount" placeholder="Enter count" min="1">
                    <label for="randomMin">Min:</label>
                    <input type="number" id="randomMin" placeholder="Min value">
                    <label for="randomMax">Max:</label>
                    <input type="number" id="randomMax" placeholder="Max value">
                </div>
            </div>

            <div class="control-card">
                <h3 class="control-title" id="randomRunTitle">Run</h3>
                <div class="input-group random-controls control-row">
                    <button class="btn-primary" id="btnRandomStart" onclick="generateRandomArray()">Generate Random Array</button>
                    <button class="btn-secondary" id="btnRandomPause" onclick="toggleRandomPause()" disabled>Pause</button>
                </div>
            </div>

            <div class="control-card">
                <h3 class="control-title" id="randomSpeedTitle">Simulation Speed</h3>
                <div class="input-group speed-controls control-row">
                    <label id="randomSpeedLabel" for="randomSpeed">Speed:</label>
                    <input type="range" id="randomSpeed" min="1" max="5" step="1" value="3" oninput="setRandomSpeedFromSlider(this.value)">
                    <span id="randomSpeedValue">1.00x</span>
                </div>
            </div>
        </section>

        <!-- Best Case Mode -->
        <section id="bestMode" class="mode">
            <h2 id="bestCaseTitle">Best Case</h2>
            <div class="description-box">
                <p id="bestCaseDesc">
                    The <strong>Best Case</strong> scenario occurs when the array still has <strong>unused capacity</strong>.
                    Inserting a new element is instant because no resizing or copying is needed.
                    <br><br>
                    Complexity: <strong>O(1)</strong>
                </p>
                <div class="control-panel">
                    <button onclick="prepareBestCase()" id="btnRunBest">Prepare Best Case</button>
                    <button onclick="prepareBestCase(true)" id="btnNextBest" style="display:none; margin-left: 8px;"></button>
                    <div id="bestCaseInputGroup" class="input-group" style="display:none; margin-top: 15px;">
                        <input type="number" id="bestInput" placeholder="Enter number">
                        <button onclick="finishBestCase()">Insert</button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Worst Case Mode -->
        <section id="worstMode" class="mode">
            <h2 id="worstCaseTitle">Worst Case</h2>
            <div class="description-box">
                <p id="worstCaseDesc">
                    The <strong>Worst Case</strong> scenario occurs when the array is <strong>completely full</strong>.
                    Inserting a new element forces a <strong>resize</strong>—allocating a larger array, copying all elements, and then inserting.
                    <br><br>
                    Complexity: <strong>O(N)</strong>
                </p>
                <div class="control-panel">
                    <button onclick="prepareWorstCase()" id="btnRunWorst">Prepare Worst Case</button>
                    <button onclick="prepareWorstCase(true)" id="btnNextWorst" style="display:none; margin-left: 8px;"></button>
                    <div id="worstCaseInputGroup" class="input-group" style="display:none; margin-top: 15px;">
                        <input type="number" id="worstInput" placeholder="Enter number">
                        <button onclick="finishWorstCase()">Insert</button>
                    </div>
                </div>
            </div>
        </section>

        <div id="arrayVisualization"></div>
    </main>

    <!-- log -->
    <div id="infoPanel">Steps will appear here</div>
</div>

<% algo.jsFiles.forEach(function(f) { %>
<script src="/<%= f %>"></script>
<% }); %>

<%- include('partials/footer') %>
</body>
</html>
