<footer>
    <p id="footerText"></p>
    <div class="footer-controls">
        <div class="toggle-pill" id="langToggle" onclick="toggleLanguage()" title="Změnit jazyk / Change language">
            <div class="toggle-option" id="langOptCZ">
                <img src="/assets/img/czech-republic.png" alt="CZ">
            </div>
            <div class="toggle-option" id="langOptEN">
                <img src="/assets/img/united-kingdom.png" alt="EN">
            </div>
        </div>
        <div class="toggle-pill" id="themeToggle" onclick="toggleTheme()" title="Přepnout téma / Switch theme">
            <div class="toggle-option" id="themeOptLight"><img src="/assets/img/light-mode.png" alt="Light"></div>
            <div class="toggle-option" id="themeOptDark"><img src="/assets/img/night-mode.png" alt="Dark"></div>
        </div>
    </div>
</footer>
