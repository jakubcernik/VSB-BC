<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: algo.theoryTitle, extraCss: ['assets/css/theory.css'] }) %>
</head>
<body>
<div id="pageTransitionOverlay"></div>

<div id="theoryContainer">

    <header>
        <h1 id="theoryMainTitle">Amortized Complexity — Dynamic Array</h1>
    </header>

    <!-- Page navigation -->
    <%- include('partials/nav-theory', { algo: algo }) %>

    <main id="theoryContent">

        <!-- Introduction -->
        <section class="theory-section" id="sec-intro">
            <h2 class="section-title" id="titleIntro">1. What is a Dynamic Array?</h2>
            <div class="section-body">
                <p id="introP1"></p>
                <p id="introP2"></p>
                <div class="info-box" id="introBox"></div>
            </div>
        </section>

        <!-- push_back operation -->
        <section class="theory-section" id="sec-pushback">
            <h2 class="section-title" id="titlePushback">2. The push_back Operation</h2>
            <div class="section-body">
                <p id="pushbackP1"></p>
                <div class="two-col">
                    <div class="case-card best" id="cardBest">
                        <div class="case-icon">✅</div>
                        <h3 id="cardBestTitle">Best Case — O(1)</h3>
                        <p id="cardBestDesc"></p>
                    </div>
                    <div class="case-card worst" id="cardWorst">
                        <div class="case-icon">⚠️</div>
                        <h3 id="cardWorstTitle">Worst Case — O(N)</h3>
                        <p id="cardWorstDesc"></p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Naive analysis -->
        <section class="theory-section" id="sec-naive">
            <h2 class="section-title" id="titleNaive">3. Why Naive Analysis Gives a Wrong Picture</h2>
            <div class="section-body">
                <p id="naiveP1"></p>
                <p id="naiveP2"></p>
            </div>
        </section>

        <!-- Amortized analysis -->
        <section class="theory-section" id="sec-amortized">
            <h2 class="section-title" id="titleAmortized">4. Amortized Analysis</h2>
            <div class="section-body">
                <p id="amortizedP1"></p>

                <!-- Method tabs -->
                <div class="method-tabs">
                    <button class="method-tab active" onclick="showMethod('aggregate')" id="tabAggregate">Aggregate Method</button>
                    <button class="method-tab" onclick="showMethod('accounting')" id="tabAccounting">Accounting Method</button>
                    <button class="method-tab" onclick="showMethod('potential')" id="tabPotential">Potential Method</button>
                </div>

                <!-- Aggregate -->
                <div class="method-content active" id="method-aggregate">
                    <h3 id="aggregateTitle">Aggregate Method</h3>
                    <p id="aggregateP1"></p>
                    <div class="math-block" id="aggregateMath"></div>
                    <p id="aggregateP2"></p>
                    <div class="math-block" id="aggregateMath2"></div>
                    <p id="aggregateConclusion"></p>
                </div>

                <!-- Accounting -->
                <div class="method-content" id="method-accounting">
                    <h3 id="accountingTitle">Accounting Method</h3>
                    <p id="accountingP1"></p>
                    <div class="coin-demo">
                        <div class="coin-step">
                            <div class="demo-coins">🪙🪙</div>
                            <p id="coinStep1"></p>
                        </div>
                        <div class="coin-step">
                            <div class="demo-coins">💳</div>
                            <p id="coinStep2"></p>
                        </div>
                        <div class="coin-step">
                            <div class="demo-coins">🏦</div>
                            <p id="coinStep3"></p>
                        </div>
                    </div>
                    <div class="math-block" id="accountingMath"></div>
                    <p id="accountingConclusion"></p>
                </div>

                <!-- Potential -->
                <div class="method-content" id="method-potential">
                    <h3 id="potentialTitle">Potential Method</h3>
                    <p id="potentialP1"></p>
                    <div class="math-block" id="potentialMath"></div>
                    <p id="potentialP2"></p>
                    <div class="math-block" id="potentialMath2"></div>
                    <p id="potentialConclusion"></p>
                </div>
            </div>
        </section>

        <!-- Growth factor -->
        <section class="theory-section" id="sec-growth">
            <h2 class="section-title" id="titleGrowth">5. Growth Factor</h2>
            <div class="section-body">
                <p id="growthP1"></p>
                <div class="growth-table-wrapper">
                    <table class="growth-table">
                        <thead>
                            <tr>
                                <th id="thFactor">Growth factor α</th>
                                <th id="thAmortized">Amortized cost</th>
                                <th id="thMemory">Memory overhead</th>
                                <th id="thExample">Used in</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>α = 1.5</td>
                                <td>O(1)</td>
                                <td id="tdLow">Low</td>
                                <td>MSVC, Rust Vec</td>
                            </tr>
                            <tr class="highlight-row">
                                <td>α = 2</td>
                                <td>O(1)</td>
                                <td id="tdMedium">Medium</td>
                                <td>GCC libstdc++, this demo</td>
                            </tr>
                            <tr>
                                <td>α = 3</td>
                                <td>O(1)</td>
                                <td id="tdHigh">High</td>
                                <td>—</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <p id="growthP2"></p>
            </div>
        </section>

        <!-- Complexity summary -->
        <section class="theory-section" id="sec-summary">
            <h2 class="section-title" id="titleSummary">6. Complexity Summary</h2>
            <div class="section-body">
                <div class="complexity-grid">
                    <div class="complexity-card">
                        <div class="complexity-op" id="opPushback">push_back</div>
                        <div class="complexity-val amortized-val">O(1)*</div>
                        <div class="complexity-note" id="notePushback"></div>
                    </div>
                    <div class="complexity-card">
                        <div class="complexity-op" id="opPushbackBest">push_back (best)</div>
                        <div class="complexity-val best-val">O(1)</div>
                        <div class="complexity-note" id="notePushbackBest"></div>
                    </div>
                    <div class="complexity-card">
                        <div class="complexity-op" id="opPushbackWorst">push_back (single worst)</div>
                        <div class="complexity-val worst-val">O(N)</div>
                        <div class="complexity-note" id="notePushbackWorst"></div>
                    </div>
                </div>
                <p class="legend" id="legendAmortized"></p>
            </div>
        </section>

        <!-- Go to simulation -->
        <section class="theory-section cta-section" id="sec-cta">
            <div class="cta-box">
                <p id="ctaText"></p>
                <a href="<%= algo.route %>" onclick="navigateTo(event, '<%= algo.route %>')" class="cta-button" id="ctaButton">⚙️ Open Simulation</a>
            </div>
        </section>

    </main>
</div>

<%- include('partials/footer') %>

<script src="/<%= algo.theoryJsFile %>"></script>
</body>
</html>
